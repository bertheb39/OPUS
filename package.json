{
  "name": "tickets",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Tickets hotspot — administration et vente",
  "author": "OPUS",
  "scripts": {
    "start": "node src/server.js",
    "preview": "node scripts/preview.mjs",
    "pc": "electron .",
    "pc:build": "electron-builder --win portable",
    "test": "node src/selfcheck.js",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.opus.tickets",
    "productName": "Tickets",
    "copyright": "OPUS",
    "directories": {
      "output": "dist/pc"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/pc-server.mjs",
      "src/mikrotik.js",
      "src/protocol.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tickets-2.2.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Tickets-2.2.exe"
    },
    "asar": true
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
